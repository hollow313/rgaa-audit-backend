# Port and Host
PORT=30019
HOST=0.0.0.0

# Storage and Keys paths
KEYS_DIR=/keys
KEY_PATH=/keys/private.pem
PUBLIC_KEY_PATH=/keys/public.pem
DB_PATH=/keys/licenses.sqlite
AUTO_GENERATE_KEYS=true

# Admin Token (obligatoire pour /api/* et pour accéder au dashboard Web GET /)
ADMIN_TOKEN=votre_jeton_secret_admin

# Active Payment Providers: 'polar', 'paddle', ou 'none' si émission manuelle / hors ligne
PAYMENT_PROVIDERS=polar

# Webhook Secrets
# Pour Polar: format Standard Webhooks (commençant par whsec_...)
POLAR_WEBHOOK_SECRET=
PADDLE_WEBHOOK_SECRET=

# Transactional Email (optional)
SMTP_URL=
SMTP_FROM=licenses@exemple.fr

# RGPD retention and CRL validity
EVENTS_RETENTION_DAYS=90
CRL_VALIDITY_HOURS=24
